{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} | {Level:u5} | {SourceContext} | traceId={TraceId} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*",
  "Features": {
    "UseInMemoryDatabase": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=roi_calculator;Username=postgres;Password=postgres"
  },
  "OpenTelemetry": {
    "ServiceName": "roi-form-api",
    "ServiceVersion": "1.0.0",
    "Otlp": {
      "Endpoint": ""
    }
  }
}
